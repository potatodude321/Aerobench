{
  "name": "aerobench-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "AeroBench (working title) \u2014 automotive CFD workbench desktop shell",
  "main": "dist-electron/main.js",
  "author": "AeroBench developers",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite",
    "build:renderer": "vite build",
    "build:electron": "tsc -p electron/tsconfig.json",
    "build": "npm run typecheck && npm run build:renderer && npm run build:electron",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "e2e": "playwright test",
    "dist:win": "npm run build && electron-builder --win nsis",
    "dist:linux": "npm run build && electron-builder --linux AppImage"
  },
  "dependencies": {
    "@mantine/core": "^9.7.1",
    "@mantine/hooks": "^9.7.1",
    "@mantine/notifications": "^9.7.1",
    "@tabler/icons-react": "^3.49.0",
    "echarts": "^6.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.0",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "typescript": "~5.9.0",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "build": {
    "appId": "com.aerobench.workbench",
    "productName": "AeroBench",
    "directories": {
      "output": "release",
      "buildResources": "build-resources"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json",
      "!node_modules/**",
      "!**/*.map"
    ],
    "asarUnpack": [
      "dist/**"
    ],
    "extraResources": [
      {
        "from": "../packaging/build/python",
        "to": "python",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../packaging/build/THIRD-PARTY-LICENSES.txt",
        "to": "THIRD-PARTY-LICENSES.txt"
      },
      {
        "from": "../packaging/build/bundle",
        "to": ".",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "AeroBench-Setup-${version}.exe",
      "icon": "build-resources/icon.png",
      "signtoolOptions": {
        "sign": "build-resources/sign.js"
      }
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AeroBench",
      "allowElevation": true,
      "include": "build-resources/installer.nsh",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Science",
      "icon": "build-resources/icon.png"
    },
    "publish": null,
    "copyright": "Copyright \u00a9 2026",
    "extraMetadata": {
      "name": "aerobench"
    }
  }
}
