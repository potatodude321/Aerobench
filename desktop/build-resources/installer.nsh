; AeroBench setup — included by electron-builder (package.json → build.nsis.include). The
; installer runs elevated (per-machine install), so Microsoft MPI is installed without another
; prompt.
;
; Layout of the installation's resources folder
;   app.asar, engine\, tools\, redist\, licenses\   the application: replaced by every setup
;   python\, openfoam\, ParaView-6.2.0\               components: large and rarely changing.
;       Each is embedded as its own archive with a content id (packaging/make_components.py)
;       and carries a marker file with that id once installed. A setup replaces a component
;       only when its id differs, so an update keeps gigabytes of unchanged files in place.
;
; Updating an installation in the same folder: electron-builder would first run the previous
; version's uninstaller, which moves every file to %TEMP% and deletes it (minutes for ~2.5 GB;
; and it fails outright when AeroBench is installed on another drive than %TEMP%). Instead the
; previous application files are removed here and the components are compared and kept.
; Projects, settings and application data are never touched by setup or uninstall.

!include LogicLib.nsh
!include "components.nsh"   ; generated by packaging/make_components.py
!ifndef AB_COMPONENTS_FORMAT
  !error "components.nsh is incomplete: run packaging/make_components.py before electron-builder"
!endif
!define AB_MARKER ".aerobench-component"

; A line in the setup's status text and in resources\setup.log (what was kept or installed).
!macro AB_Log TEXT
  DetailPrint "${TEXT}"
  ClearErrors
  FileOpen $R5 "$INSTDIR\resources\setup.log" a
  ${IfNot} ${Errors}
    FileSeek $R5 0 END
    FileWrite $R5 "${TEXT}$\r$\n"
    FileClose $R5
  ${EndIf}
!macroend

!ifndef BUILD_UNINSTALLER
Var AB_Updating
Var AB_Changed
Var AB_Py

; Remove a folder; if files in it are in use, ask to close what uses them and retry.
; Push <folder>, Push <label>
Function AB_RemoveDir
  Exch $R1 ; label
  Exch
  Exch $R0 ; folder
  ${Do}
    RMDir /r "$R0"
    ${IfNot} ${FileExists} "$R0\*.*"
      ${Break}
    ${EndIf}
    MessageBox MB_RETRYCANCEL|MB_ICONEXCLAMATION "Some files of $R1 are in use and cannot be replaced:$\r$\n$R0$\r$\n$\r$\nClose programs that use them (AeroBench, ParaView, a command prompt in that folder), then click Retry." /SD IDCANCEL IDRETRY ab_retry
    SetErrorLevel 5
    Quit
    ab_retry:
  ${Loop}
  Pop $R0
  Pop $R1
FunctionEnd

; Remove the previous version's application files (everything except the components, which
; are compared with this version afterwards).
Function AB_RemoveAppFiles
  Push $R1
  Push $R2
  FindFirst $R1 $R2 "$INSTDIR\*.*"
  ${DoWhile} $R2 != ""
    ${If} $R2 != "."
    ${AndIf} $R2 != ".."
    ${AndIf} $R2 != "resources"
      ${If} ${FileExists} "$INSTDIR\$R2\*.*"
        RMDir /r "$INSTDIR\$R2"
      ${Else}
        Delete "$INSTDIR\$R2"
      ${EndIf}
    ${EndIf}
    FindNext $R1 $R2
  ${Loop}
  FindClose $R1
  FindFirst $R1 $R2 "$INSTDIR\resources\*.*"
  ${DoWhile} $R2 != ""
    ${If} $R2 != "."
    ${AndIf} $R2 != ".."
    ${AndIf} $R2 != "${AB_PYTHON_DIR}"
    ${AndIf} $R2 != "${AB_OPENFOAM_DIR}"
    ${AndIf} $R2 != "${AB_PARAVIEW_DIR}"
      ${If} ${FileExists} "$INSTDIR\resources\$R2\*.*"
        RMDir /r "$INSTDIR\resources\$R2"
      ${Else}
        Delete "$INSTDIR\resources\$R2"
      ${EndIf}
    ${EndIf}
    FindNext $R1 $R2
  ${Loop}
  FindClose $R1
  Pop $R2
  Pop $R1
FunctionEnd

; Decide whether a component is kept and (re)install it when not. $AB_Changed = 1 when it was
; installed now. A marker with this version's id plus all files at their recorded sizes: kept.
; No marker (installed by a version before components existed): kept only if every file is
; byte-identical to this version. Anything else: removed and installed from this setup.
!macro AB_Component NAME DIR ID ARCHIVE LABEL KEY
  StrCpy $AB_Changed "0"
  StrCpy $R9 ""
  ClearErrors
  FileOpen $R8 "$INSTDIR\resources\${DIR}\${AB_MARKER}" r
  ${IfNot} ${Errors}
    FileRead $R8 $R9
    FileClose $R8
  ${EndIf}
  StrCpy $R7 "install"
  ${If} ${FileExists} "$INSTDIR\resources\${DIR}\${KEY}"
  ${AndIf} ${FileExists} "$AB_Py"
    ${If} $R9 == "${ID}"
      nsExec::ExecToLog '"$AB_Py" -I "$INSTDIR\resources\tools\components.py" verify --quick "$INSTDIR\resources" ${NAME}'
      Pop $R6
      ${If} $R6 == "0"
        StrCpy $R7 "keep"
      ${EndIf}
    ${ElseIf} $R9 == ""
      DetailPrint "Comparing the installed ${LABEL} with this version..."
      nsExec::ExecToStack '"$AB_Py" -I "$INSTDIR\resources\tools\components.py" verify "$INSTDIR\resources" ${NAME}'
      Pop $R6
      Pop $R4
      ${Do} ; the output ends with a line break
        StrCpy $R3 $R4 1 -1
        ${If} $R3 == "$\n"
        ${OrIf} $R3 == "$\r"
          StrCpy $R4 $R4 -1
        ${Else}
          ${Break}
        ${EndIf}
      ${Loop}
      !insertmacro AB_Log "${LABEL}: comparison with the installed files (code $R6): $R4"
      ${If} $R6 == "0"
        StrCpy $R7 "keep"
      ${EndIf}
    ${EndIf}
  ${EndIf}
  ${If} $R7 == "keep"
    !insertmacro AB_Log "${LABEL}: unchanged, kept (${ID})"
  ${Else}
    !insertmacro AB_Log "${LABEL}: installing (${ID}; installed: $R9)"
    Push "$INSTDIR\resources\${DIR}"
    Push "${LABEL}"
    Call AB_RemoveDir
    ; the archive is already compressed (7z): stored as is
    SetCompress off
    File "/oname=$PLUGINSDIR\${NAME}.7z" "${ARCHIVE}"
    !ifdef COMPRESS
      SetCompress "${COMPRESS}"
    !else
      SetCompress auto
    !endif
    SetOutPath "$INSTDIR\resources"
    Nsis7z::ExtractWithDetails "$PLUGINSDIR\${NAME}.7z" "Installing ${LABEL} %s..."
    SetOutPath "$INSTDIR"
    Delete "$PLUGINSDIR\${NAME}.7z"
    nsExec::ExecToLog '"$INSTDIR\resources\python\python.exe" -I "$INSTDIR\resources\tools\components.py" verify --quick "$INSTDIR\resources" ${NAME}'
    Pop $R6
    ${If} $R6 != "0"
      !insertmacro AB_Log "${LABEL}: incomplete after extraction (check result $R6)"
      MessageBox MB_OK|MB_ICONSTOP "${LABEL} could not be installed completely (check result: $R6).$\r$\nMake sure the drive has enough free space, then run this setup again." /SD IDOK
      SetErrorLevel 4
      Quit
    ${EndIf}
    StrCpy $AB_Changed "1"
  ${EndIf}
!macroend

; Record that a component is complete (after its post-installation steps).
!macro AB_Mark DIR ID
  ClearErrors
  FileOpen $R8 "$INSTDIR\resources\${DIR}\${AB_MARKER}" w
  ${IfNot} ${Errors}
    FileWrite $R8 "${ID}"
    FileClose $R8
  ${EndIf}
!macroend

; Same folder as the installation found in the registry: update in place.
!macro AB_PrepareUpdate
  SetDetailsPrint textonly
  StrCpy $AB_Updating "0"
  ReadRegStr $R0 SHELL_CONTEXT "${INSTALL_REGISTRY_KEY}" InstallLocation
  ${If} $R0 != ""
  ${AndIf} $R0 == $INSTDIR
  ${AndIf} ${FileExists} "$INSTDIR\${APP_EXECUTABLE_FILENAME}"
  ${AndIf} ${FileExists} "$INSTDIR\resources\app.asar"
    StrCpy $AB_Updating "1"
    ReadRegStr $R1 SHELL_CONTEXT "${UNINSTALL_REGISTRY_KEY}" DisplayVersion
    DetailPrint "Updating AeroBench $R1 to ${VERSION}..."
    ; without an uninstall command electron-builder does not run the previous uninstaller;
    ; the new one is registered at the end of the file installation
    DeleteRegValue SHELL_CONTEXT "${UNINSTALL_REGISTRY_KEY}" UninstallString
    DeleteRegValue SHELL_CONTEXT "${UNINSTALL_REGISTRY_KEY}" QuietUninstallString
    !ifdef UNINSTALL_REGISTRY_KEY_2
      DeleteRegValue SHELL_CONTEXT "${UNINSTALL_REGISTRY_KEY_2}" UninstallString
      DeleteRegValue SHELL_CONTEXT "${UNINSTALL_REGISTRY_KEY_2}" QuietUninstallString
    !endif
    DetailPrint "Removing the previous application files..."
    Call AB_RemoveAppFiles
    !insertmacro AB_Log "Updating AeroBench $R1 to ${VERSION} in $INSTDIR (projects and settings are kept)"
  ${EndIf}
!macroend
!endif

!macro customInstall
  ; disk space shown on the folder page: the components are stored compressed in the setup
  AddSize ${AB_COMPONENTS_KB}
  ; electron-builder hides all status text; ours says what is being installed or kept
  SetDetailsPrint textonly
  ${If} $AB_Updating != "1"
    !insertmacro AB_Log "Installing AeroBench ${VERSION} in $INSTDIR"
  ${EndIf}
  StrCpy $AB_Py "$INSTDIR\resources\python\python.exe"

  ; --- 1. components (the Python runtime first: the checks of the others run with it) -------
  !insertmacro AB_Component python "${AB_PYTHON_DIR}" "${AB_PYTHON_ID}" "${AB_PYTHON_ARCHIVE}" "${AB_PYTHON_LABEL}" "${AB_PYTHON_KEY}"
  ${If} $AB_Changed == "1"
    ; the folder is read-only for users afterwards: without compiled modules every start would
    ; compile them in memory (slow start-up)
    DetailPrint "Optimising the Python modules (about a minute)..."
    nsExec::ExecToLog '"$INSTDIR\resources\python\python.exe" -I -m compileall -q -j 0 "$INSTDIR\resources\python\Lib\site-packages"'
    Pop $0
  ${EndIf}
  !insertmacro AB_Mark "${AB_PYTHON_DIR}" "${AB_PYTHON_ID}"
  StrCpy $AB_Py "$INSTDIR\resources\python\python.exe"

  DetailPrint "Optimising the engine modules..."
  nsExec::ExecToLog '"$INSTDIR\resources\python\python.exe" -I -m compileall -q -j 0 "$INSTDIR\resources\engine"'
  Pop $0

  !insertmacro AB_Component openfoam "${AB_OPENFOAM_DIR}" "${AB_OPENFOAM_ID}" "${AB_OPENFOAM_ARCHIVE}" "${AB_OPENFOAM_LABEL}" "${AB_OPENFOAM_KEY}"
  !insertmacro AB_Mark "${AB_OPENFOAM_DIR}" "${AB_OPENFOAM_ID}"

  !insertmacro AB_Component paraview "${AB_PARAVIEW_DIR}" "${AB_PARAVIEW_ID}" "${AB_PARAVIEW_ARCHIVE}" "${AB_PARAVIEW_LABEL}" "${AB_PARAVIEW_KEY}"
  ${If} $AB_Changed == "1"
    DetailPrint "Optimising the ParaView Python modules..."
    nsExec::ExecToLog '"$INSTDIR\resources\python\python.exe" -I -m compileall -q -j 0 "$INSTDIR\resources\${AB_PARAVIEW_DIR}\bin\Lib"'
    Pop $0
  ${EndIf}
  ; ParaView's duplicate DLLs, removed from the package, are recreated as hard links. Always
  ; run: it is quick when nothing is missing, so a repeated setup also repairs them.
  DetailPrint "Completing the ParaView installation..."
  nsExec::ExecToLog '"$INSTDIR\resources\python\python.exe" -I "$INSTDIR\resources\tools\restore_links.py" "$INSTDIR\resources"'
  Pop $0
  ${If} $0 != "0"
    !insertmacro AB_Log "ParaView file restoration reported code $0 (see resources\tools\restore_links.log)"
    MessageBox MB_ICONEXCLAMATION|MB_OK "Some ParaView files could not be restored (code $0).$\r$\nAeroBench works, but if result images fail, run this setup again to repair the installation." /SD IDOK
  ${EndIf}
  !insertmacro AB_Mark "${AB_PARAVIEW_DIR}" "${AB_PARAVIEW_ID}"

  ; --- 2. Microsoft MPI (needed by every OpenFOAM program of the Windows build) -----------
  ${IfNot} ${FileExists} "$PROGRAMFILES64\Microsoft MPI\Bin\mpiexec.exe"
    DetailPrint "Installing Microsoft MPI 10.1.3..."
    SetOutPath "$INSTDIR\resources\redist"
    ExecWait '"$INSTDIR\resources\redist\msmpisetup.exe" -unattend' $1
    SetOutPath "$INSTDIR"
    ${If} ${FileExists} "$PROGRAMFILES64\Microsoft MPI\Bin\mpiexec.exe"
      !insertmacro AB_Log "Microsoft MPI 10.1.3 installed"
    ${Else}
      !insertmacro AB_Log "Microsoft MPI setup ended with code $1"
      MessageBox MB_ICONEXCLAMATION|MB_OK "Microsoft MPI could not be installed (code $1).$\r$\nAeroBench will offer to install it when it starts (Welcome screen, Environment)." /SD IDOK
    ${EndIf}
  ${Else}
    DetailPrint "Microsoft MPI is already installed."
  ${EndIf}

  ; --- 3. housekeeping ---------------------------------------------------------------------
  ; electron-builder keeps a copy of the whole setup for its auto-updater, which AeroBench
  ; does not use: about 1 GB in the user's AppData, removed again
  !ifdef APP_INSTALLER_STORE_FILE
    SetShellVarContext current
    Delete "$LOCALAPPDATA\${APP_INSTALLER_STORE_FILE}"
    ${StdUtils.GetParentPath} $0 "$LOCALAPPDATA\${APP_INSTALLER_STORE_FILE}"
    RMDir "$0"
    SetShellVarContext all
  !endif
  ; size shown in Windows Settings > Apps (electron-builder counts only the application files)
  !ifdef ESTIMATED_SIZE
    IntOp $0 ${ESTIMATED_SIZE} + ${AB_COMPONENTS_KB}
  !else
    IntOp $0 0 + ${AB_COMPONENTS_KB}
  !endif
  IntFmt $0 "0x%08X" $0
  WriteRegDWORD SHELL_CONTEXT "${UNINSTALL_REGISTRY_KEY}" "EstimatedSize" "$0"
  !insertmacro AB_Log "Done."
!macroend

!macro customUnInstall
  ; Microsoft MPI is a shared system component (other software may use it): it is kept.
  ; Remove it from Windows Settings > Apps if no longer needed.
!macroend

; electron-builder's default moves every file to %TEMP% first (to restore them if one is in
; use), which copies gigabytes when AeroBench is on another drive and then fails. The setup
; checks for running AeroBench processes beforehand (customCheckAppRunning).
!macro customRemoveFiles
  SetOutPath $TEMP
  RMDir /r $INSTDIR
!macroend

; Replaces electron-builder's default check, which would kill every process started from the
; installation folder — now including running OpenFOAM simulations — without saying so.
; tools\running.py (run with the installation's own Python) tells the application apart from
; simulations; simulations are stopped gracefully (state written, resumable) only if the user
; agrees. Silent installs never stop simulations: they exit with code 3 instead.
!macro customCheckAppRunning
  ${If} ${FileExists} "$INSTDIR\resources\python\python.exe"
  ${AndIf} ${FileExists} "$INSTDIR\resources\tools\running.py"
    nsExec::ExecToLog '"$INSTDIR\resources\python\python.exe" -I "$INSTDIR\resources\tools\running.py" check "$INSTDIR"'
    Pop $R0
    ${If} $R0 == 20
      ${If} ${Cmd} `MessageBox MB_OKCANCEL|MB_ICONEXCLAMATION "AeroBench simulations are running.$\r$\n$\r$\nOK: stop them now. Each one writes its current state and can be resumed afterwards (Run page > Resume).$\r$\nCancel: quit this setup and let them finish." /SD IDCANCEL IDOK`
        DetailPrint "Closing AeroBench..."
        nsExec::ExecToLog '"$INSTDIR\resources\python\python.exe" -I "$INSTDIR\resources\tools\running.py" close-app "$INSTDIR"'
        Pop $R0
        DetailPrint "Stopping simulations (each writes its current state; this can take a few minutes)..."
        nsExec::ExecToLog '"$INSTDIR\resources\python\python.exe" -I "$INSTDIR\resources\tools\running.py" stop-sims "$INSTDIR"'
        Pop $R0
        ${If} $R0 != 0
          MessageBox MB_OK|MB_ICONSTOP "Some simulations did not stop. Stop them in AeroBench (Run page), then run this setup again." /SD IDOK
          SetErrorLevel 3
          Quit
        ${EndIf}
      ${Else}
        SetErrorLevel 3
        Quit
      ${EndIf}
    ${ElseIf} $R0 == 10
      ${If} ${Cmd} `MessageBox MB_OKCANCEL|MB_ICONEXCLAMATION "AeroBench is running. Click OK to close it and continue." /SD IDOK IDOK`
        nsExec::ExecToLog '"$INSTDIR\resources\python\python.exe" -I "$INSTDIR\resources\tools\running.py" close-app "$INSTDIR"'
        Pop $R0
        Sleep 500
      ${Else}
        Quit
      ${EndIf}
    ${ElseIf} $R0 != 0
      MessageBox MB_OK|MB_ICONEXCLAMATION "The setup could not check whether AeroBench or a simulation is running.$\r$\nClose AeroBench and stop running simulations, then click OK." /SD IDOK
    ${EndIf}
  ${EndIf}
  !ifndef BUILD_UNINSTALLER
    !insertmacro AB_PrepareUpdate
  !endif
!macroend
